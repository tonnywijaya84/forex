# Salin file ini menjadi .env.local, lalu isi nilainya.

# Dari dashboard Supabase: Project Settings > API Keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Kunci untuk menandatangani jawaban API lisensi. Buat dengan: openssl rand -hex 32
# Nilai yang sama ditanam di EA untuk memeriksa tanda tangan. Jangan dibagikan.
LICENSE_SIGNING_SECRET=

# Alamat ketiga situs. Saat pengembangan lokal boleh dikosongkan.
NEXT_PUBLIC_URL_EDUKASI=http://localhost:3001
NEXT_PUBLIC_URL_TOKO=http://localhost:3002
NEXT_PUBLIC_URL_PORTAL=http://localhost:3003
